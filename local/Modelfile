# stardew-local: the model the local runs play with. Qwen3.5 9B (Apache 2.0) from the Ollama library, with the
# settings tuned for the mod's built-in AI: a 48k context (system prompt + compact tools are about 20k tokens),
# low temperature for steadier tool calls, a 2048-token answer cap. setup.ps1 builds it with:
#   ollama pull qwen3.5:9b
#   ollama create stardew-local -f Modelfile
FROM qwen3.5:9b
PARAMETER num_ctx 49152
PARAMETER num_predict 2048
PARAMETER temperature 0.3
PARAMETER top_k 20
PARAMETER top_p 0.95
PARAMETER presence_penalty 1.5
