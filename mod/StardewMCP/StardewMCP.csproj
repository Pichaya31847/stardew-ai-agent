<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>StardewMCP</RootNamespace>
    <Version>0.1.0</Version>
    <EnableHarmony>true</EnableHarmony>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.*" />
  </ItemGroup>

  <!-- Overlay and replay pages moved to studio/; linked here while AgentHttp still serves /overlay and /replay. -->
  <ItemGroup>
    <None Include="..\..\studio\overlay.html" Link="assets\overlay.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\studio\replay.html" Link="assets\replay.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
